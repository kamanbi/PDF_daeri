# ─────────────────────────────────────────────
# 비밀값 — 절대 커밋 금지
# 실제 키는 F:\keys\PDF_대리 에 보관한다 (리포지토리 밖)
# ─────────────────────────────────────────────
*.jks
*.keystore
key.properties
android/key.properties
android/ads.properties
.env
.env.*
!.env.example
google-services.json
android/app/google-services.json
service-account*.json

# ─────────────────────────────────────────────
# Node.js (netlify/functions 빌드 도구)
# ─────────────────────────────────────────────
node_modules/

# ─────────────────────────────────────────────
# Flutter / Dart
# ─────────────────────────────────────────────
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata
doc/api/
*.dart.js
*.info.json
*.js_
*.js.deps
*.js.map
coverage/

# pubspec.lock 은 앱이므로 커밋한다 (의존성 버전 고정)

# ─────────────────────────────────────────────
# Android
# ─────────────────────────────────────────────
android/.gradle/
android/.kotlin/
android/gradle/
android/gradlew
android/gradlew.bat
android/captures/
android/local.properties
android/.idea/
android/app/debug/
android/app/profile/
android/app/release/
*.apk
*.aab
*.ap_
*.dex
*.class
.cxx/

# ─────────────────────────────────────────────
# IDE / 에디터
# ─────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
*.swp
*~

# ─────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ─────────────────────────────────────────────
# 작업 산출물 (로컬 보존, 커밋 제외)
# ─────────────────────────────────────────────
_workspace/
_workspace_*/
.omc/

# 테스트 픽스처 중 대용량 PDF (필요한 것만 -f 로 추가)
test/fixtures/large/

# 테스트 픽스처 대용량 파일
test/fixtures/

# ─────────────────────────────────────────────
# QPDF 마이그레이션(M-Q0) — 네이티브 크로스컴파일 중간 산출물
# 빌드 스크립트(tool/build_qpdf_android.sh)와 매니페스트만 커밋한다.
# 최종 .so는 android/app/src/main/jniLibs/<abi>/ 에 별도로 커밋한다.
# install-* 아래의 정적 라이브러리·CLI 실행 파일·문서·man 페이지는
# libqpdf.so를 만들기 위한 중간 산출물이므로 커밋하지 않는다.
# ─────────────────────────────────────────────
native/*/install-*/
native/*/build-*/
native/*/*.tar.gz
native/*/src-*/
.qpdf_build_tmp/

# Local Netlify folder
.netlify

# 빌드 로그 스크래치 파일
build_log.txt

# ─────────────────────────────────────────────
# Windows 설치 프로그램 — 다운로드 바이너리/빌드 산출물
# .iss 스크립트(소스)만 커밋한다. vcredist_x64.exe는 Microsoft 공식 재배포
# 바이너리(다운로드 파일, 25MB)라 커밋 대상이 아니다 — W5 실행 시 매번 새로
# 받거나 별도 보관한다.
# ─────────────────────────────────────────────
windows/installer/vcredist_x64.exe
windows/installer/*.exe

# ─────────────────────────────────────────────
# 빌드 로그 / JVM 크래시 덤프 / 기기 스크린샷 / 격리 gradle 캐시
# (환경 변수·로컬 경로가 포함될 수 있어 커밋 금지)
# ─────────────────────────────────────────────
*.log
hs_err_pid*.log
replay_pid*.log
/device-*.png
.gradle-isolated/
.gradle-mlkit/

# iOS qpdf 정적 라이브러리(CI에서 tool/build_qpdf_ios.sh로 생성)
/ios/qpdf/
/.qpdf_build_tmp/
